# shortform_lab configuration
#
# All values are optional. The prototype runs fully offline using a provided
# transcript (--transcript) and the deterministic planner. Set these only to
# enable the OpenAI-backed transcription and/or LLM edit planner.

# OpenAI API key for Whisper transcription and LLM edit planning.
OPENAI_API_KEY=somekey

# Model used for LLM edit planning (optional; defaults set in code).
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Model used for audio transcription (optional; defaults set in code).
OPENAI_TRANSCRIBE_MODEL=whisper-1

# uv run python -m shortform_lab.cli process <path_to_clip> --style bold_creator 